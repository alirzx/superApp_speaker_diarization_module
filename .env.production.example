# GitLab ENV_FILE production template. Replace API_TOKEN with a unique secret.
# The server must actually own 192.168.4.209 on a network interface.
APP_ENV=production
API_TOKEN=REPLACE_WITH_UNIQUE_PRODUCTION_TOKEN_AT_LEAST_32_CHARACTERS
MODEL_PATH=/models/Nemotron-3-Diarization.q8_0.gguf
MODEL_MANIFEST=/models/manifest.json
CPU_THREADS=2
MAX_CONCURRENT_INFERENCE=1
MAX_QUEUE_WAIT_SECONDS=10
INFERENCE_TIMEOUT_SECONDS=600
MAX_UPLOAD_MB=25
MAX_AUDIO_SECONDS=300
# Keep API loopback-only; Nginx UI proxies /api to api:8000 over Docker network.
API_BIND_IP=127.0.0.1
API_PORT=8003
# Bind the UI to the team's LAN address, not 127.0.0.1.
UI_BIND_IP=192.168.4.209
UI_PORT=8084
API_CPUS=2.0
API_MEMORY=1500m
UI_CPUS=0.5
UI_MEMORY=256m
HF_HOME=/models/.cache
HF_HUB_ETAG_TIMEOUT=30
HF_HUB_DOWNLOAD_TIMEOUT=300

# Python requirements/build dependencies: regional mirrors, sequential fallback.
PIP_PRIMARY_INDEX_URL=https://package-mirror.liara.ir/repository/pypi/simple
PIP_FALLBACK_INDEX_URL=https://mirror2.chabokan.net/pypi/simple/

# Debian 12 Bookworm APT mirrors: signed metadata, primary -> fallback, HTTPS.
# Only used at Docker build time. Change to an authorized reachable mirror if needed.
APT_PRIMARY_DEBIAN_URL=https://mirror.metanet.ch/debian
APT_PRIMARY_SECURITY_URL=https://mirror.metanet.ch/debian-security
APT_FALLBACK_DEBIAN_URL=https://mirrors.huaweicloud.com/repository/debian
APT_FALLBACK_SECURITY_URL=https://mirrors.huaweicloud.com/repository/debian-security
