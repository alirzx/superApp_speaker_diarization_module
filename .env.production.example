# Server template, not deployable until API_TOKEN is set to a real secret.
APP_ENV=production
API_TOKEN=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
MODEL_PATH=/models/Nemotron-3-Diarization.q8_0.gguf
MODEL_MANIFEST=/models/manifest.json
CPU_THREADS=2
MAX_CONCURRENT_INFERENCE=1
MAX_QUEUE_WAIT_SECONDS=10
INFERENCE_TIMEOUT_SECONDS=600
MAX_UPLOAD_MB=25
MAX_AUDIO_SECONDS=300
# Loopback when the TLS/SSO gateway is on the same host.
API_BIND_IP=127.0.0.1
API_PORT=8003
UI_BIND_IP=127.0.0.1
UI_PORT=8084
API_CPUS=2.0
API_MEMORY=1500m
UI_CPUS=0.5
UI_MEMORY=256m
